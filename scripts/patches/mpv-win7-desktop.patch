+
+// Haswell and Broadwell have no fixed-function HEVC decoder. Hybrid surfaces
+// break dxva2-egl StretchRect and can hang bare d3d11va; refuse zero-copy.
+static bool d3d_intel_hybrid_hevc(UINT vendor_id, UINT device_id)
+{
+    if (vendor_id != 0x8086)
+        return false;
+    switch (device_id & 0xff00) {
+    case 0x0400: case 0x0a00: case 0x0c00: case 0x0d00: // Haswell
+    case 0x1600:                                        // Broadwell
+        return true;
+    }
+    return false;
+}
+
+// Whether dxva2-egl can show these frames. It converts surfaces to RGB with
+// D3D9 StretchRect, which drivers only do reliably for NV12.
+bool d3d9_interop_allowed(struct AVBufferRef *device_ref, int av_codec_id,
+                          int av_sw_format)
+{
+    if (av_sw_format != AV_PIX_FMT_NV12)
+        return false;
+    if (av_codec_id != AV_CODEC_ID_HEVC)
+        return true;
+
+    AVHWDeviceContext *ctx = (void *)device_ref->data;
+    AVDXVA2DeviceContext *hwctx = ctx->hwctx;
+    HANDLE handle = NULL;
+    IDirect3DDevice9 *device = NULL;
+    IDirect3D9 *d3d9 = NULL;
+    D3DDEVICE_CREATION_PARAMETERS params;
+    D3DADAPTER_IDENTIFIER9 id;
+    bool allowed = true;
+
+    // Fail closed: cannot query adapter → refuse interop (avoids hybrid HEVC blue/green).
+    if (FAILED(IDirect3DDeviceManager9_OpenDeviceHandle(hwctx->devmgr, &handle)))
+        return false;
+    if (FAILED(IDirect3DDeviceManager9_LockDevice(hwctx->devmgr, handle,
+                                                  &device, TRUE)))
+    {
+        IDirect3DDeviceManager9_CloseDeviceHandle(hwctx->devmgr, handle);
+        return false;
+    }
+    if (SUCCEEDED(IDirect3DDevice9_GetDirect3D(device, &d3d9)) &&
+        SUCCEEDED(IDirect3DDevice9_GetCreationParameters(device, &params)) &&
+        SUCCEEDED(IDirect3D9_GetAdapterIdentifier(d3d9, params.AdapterOrdinal,
+                                                  0, &id)))
+        allowed = !d3d_intel_hybrid_hevc(id.VendorId, id.DeviceId);
+    else
+        allowed = false;
+    SAFE_RELEASE(d3d9);
+    IDirect3DDeviceManager9_UnlockDevice(hwctx->devmgr, handle, FALSE);
+    SAFE_RELEASE(device);
+    IDirect3DDeviceManager9_CloseDeviceHandle(hwctx->devmgr, handle);
+    return allowed;
 }
+
+#if HAVE_D3D_HWACCEL
+// Bare d3d11va (zero-copy) on Intel hybrid HEVC can stall the process; refuse
+// so hwdec=auto falls through to d3d11va-copy or software. DXGI GetDesc only
+// (no CheckVideoDecoderSupport — that probe hung Optimus / multi-adapter).
+bool d3d11_interop_allowed(struct AVBufferRef *device_ref, int av_codec_id,
+                           int av_sw_format)
+{
+    (void)av_sw_format;
+    if (av_codec_id != AV_CODEC_ID_HEVC)
+        return true;
+
+    AVHWDeviceContext *ctx = (void *)device_ref->data;
+    AVD3D11VADeviceContext *hwctx = ctx->hwctx;
+    IDXGIDevice *dxgi_dev = NULL;
+    IDXGIAdapter *adapter = NULL;
+    DXGI_ADAPTER_DESC desc;
+    bool allowed = true;
+
+    if (!hwctx || !hwctx->device)
+        return false;
+    if (FAILED(ID3D11Device_QueryInterface(hwctx->device, &IID_IDXGIDevice,
+                                           (void **)&dxgi_dev)))
+        return false;
+    if (FAILED(IDXGIDevice_GetAdapter(dxgi_dev, &adapter))) {
+        IDXGIDevice_Release(dxgi_dev);
+        return false;
+    }
+    if (SUCCEEDED(IDXGIAdapter_GetDesc(adapter, &desc)))
+        allowed = !d3d_intel_hybrid_hevc(desc.VendorId, desc.DeviceId);
+    else
+        allowed = false;
+    IDXGIAdapter_Release(adapter);
+    IDXGIDevice_Release(dxgi_dev);
+    return allowed;
+}
+#endif
 
